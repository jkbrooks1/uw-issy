---
// Buildspec section 28 — server-render everything that doesn't need the
// browser. The public package is read directly from disk at build time
// (this is a static build; there is no running server to self-fetch from
// during `astro build`), then normalized through the same adapters the
// buildspec requires the browser to use if it ever needs to re-derive
// state client-side.
//
// Route-first hierarchy: SiteHeader -> Route status summary -> Route map
// -> Current issues -> Closures and detours -> Weather/air/smoke
// -> Route facilities -> System health.
import "../styles/route-status.css";
import { readFileSync } from "node:fs";
import { join } from "node:path";

import SiteHeader from "../components/site/SiteHeader.astro";
import SiteFooter from "../components/site/SiteFooter.astro";
import DashboardHeading from "../components/route-status/DashboardHeading.astro";
import RiderImpactGrid from "../components/route-status/RiderImpactGrid.astro";
import RouteMap from "../components/route-status/RouteMap.svelte";
import CurrentRouteAlerts from "../components/route-status/CurrentRouteAlerts.astro";
import ClosuresAndDetours from "../components/route-status/ClosuresAndDetours.astro";
import WeatherAirSummary from "../components/route-status/WeatherAirSummary.astro";
import RouteImpacts from "../components/route-status/RouteImpacts.astro";
import MonitorHealthDisclosure from "../components/route-status/MonitorHealthDisclosure.astro";

import { normalizeDashboardData } from "../lib/route-status/normalize-dashboard-data";
import { normalizeRouteEvents } from "../lib/route-status/normalize-route-events";
import type { DashboardDataFile, RouteEventsFile, SystemHealthFile } from "../lib/route-status/types";

const publicDataDir = join(process.cwd(), "public", "data");

function readJson<T>(fileName: string): T | null {
  try {
    return JSON.parse(readFileSync(join(publicDataDir, fileName), "utf8")) as T;
  } catch {
    return null;
  }
}

const dashboardDataFile = readJson<DashboardDataFile>("dashboard-data.json");
const routeEventsFile = readJson<RouteEventsFile>("route-events.geojson");
const systemHealth = readJson<SystemHealthFile>("system-health.json");

const packageAvailable = dashboardDataFile !== null && routeEventsFile !== null;

const summary = dashboardDataFile
  ? normalizeDashboardData(dashboardDataFile)
  : {
      displayTier: "unknown" as const,
      displayTierLabel: "Status unknown",
      activeEventCount: 0,
      overallMessage: null,
      lastUpdatedLabel: null,
      laneSummaries: [],
      routeImpacts: null,
    };

const { events } = routeEventsFile
  ? normalizeRouteEvents(routeEventsFile)
  : { events: [], gaps: [] };

const facilitiesLane = summary.laneSummaries.find((lane) => lane.laneId === "08_ROUTE_FACILITIES") ?? null;
const facilitiesEvents = events.filter((event) => event.laneId === "08_ROUTE_FACILITIES");
const facilitiesCurrent = facilitiesLane?.sourceStateText === "Current";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>UW-Issaquah BG/SRT/ELST Status | BikeTourFrance.net</title>
    <meta
      name="description"
      content="University of Washington to Issaquah"
    />
  </head>
  <body>
    <SiteHeader />
    <main class="page-frame">
      <DashboardHeading summary={summary} />

      <div class="dashboard-layout">
        <div class="item-route-status">
          <RiderImpactGrid summary={summary} />
        </div>

        <section class="panel item-route-map" aria-labelledby="route-map-heading">
          <h2 class="panel__heading" id="route-map-heading">UW-Issaquah Cycling Route</h2>
          <RouteMap client:only="svelte" routeDisplayTier={summary.displayTier} />
        </section>

        <div class="item-route-alerts">
          <CurrentRouteAlerts events={events} hasSourceFailures={false} />
        </div>

        <div class="item-closures">
          <ClosuresAndDetours events={events} />
        </div>

        <div class="item-weather-air">
          <WeatherAirSummary laneSummaries={summary.laneSummaries} events={events} />
        </div>

        <div class="item-route-impacts">
          <RouteImpacts routeImpacts={summary.routeImpacts} />
        </div>

        {
          facilitiesLane && (
            <div class="item-facilities">
              {facilitiesEvents.length === 0 ? (
                facilitiesCurrent && <p class="empty-note">No current facility issues reported.</p>
              ) : (
                <section class="panel" aria-labelledby="route-facilities-heading">
                  <h2 class="panel__heading" id="route-facilities-heading">Route facilities</h2>
                  <ul class="lane-list">
                    {facilitiesEvents.map((event) => (
                      <li class="lane-row">
                        <span class="lane-row__body">
                          <span class="lane-row__label">{event.title}</span>
                          <span class="lane-row__meta">
                            {event.locationLabel ?? event.routeSegmentLabel ?? event.routeSegmentId ?? "Location not stated by source"}
                          </span>
                        </span>
                      </li>
                    ))}
                  </ul>
                </section>
              )}
            </div>
          )
        }

        <div class="item-monitor-health">
          <MonitorHealthDisclosure summary={summary} systemHealth={systemHealth} />
        </div>
      </div>
    </main>
    <SiteFooter />
  </body>
</html>
