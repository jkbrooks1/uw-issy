---
import type { RouteWideSummary } from "../../lib/route-status/normalize-dashboard-data";
import type { SystemHealthFile } from "../../lib/route-status/types";

type Props = {
  summary: RouteWideSummary;
  systemHealth: SystemHealthFile | null;
};

const { summary, systemHealth } = Astro.props;

const hasIncompleteSources =
  (systemHealth?.failedLaneIds.length ?? 0) > 0 || (systemHealth?.degradedLaneIds.length ?? 0) > 0;
---

<section class="panel system-health-panel" aria-labelledby="system-health-heading">
  <h2 class="panel__heading" id="system-health-heading">System health</h2>
  {
    systemHealth === null ? (
      <p class="empty-note">Current monitoring data is unavailable.</p>
    ) : (
      <>
        <p class="empty-note">
          {summary.lastUpdatedLabel ? <>Current as of {summary.lastUpdatedLabel}.</> : <>Update time unavailable</>}
        </p>
        {hasIncompleteSources && (
          <p class="empty-note">Some monitoring sources did not return complete data.</p>
        )}
        <ul class="lane-list">
          {systemHealth.lanes.map((lane) => (
            <li class="lane-row">
              <span class="lane-row__body">
                <span class="lane-row__label">{lane.laneLabel}</span>
                <span class="lane-row__meta">{lane.publicText}</span>
                {lane.usingLastKnownGood && (
                  <span class="lane-row__lkg">Showing last known data</span>
                )}
              </span>
            </li>
          ))}
        </ul>
      </>
    )
  }
</section>
