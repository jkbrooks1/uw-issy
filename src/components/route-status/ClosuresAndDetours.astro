---
import type { DashboardEventWithUnknownLane } from "../../lib/route-status/types";
import { formatPacificTime } from "../../lib/route-status/format-time";
import { isClosureEvent } from "../../lib/route-status/rider-state";

type Props = {
  events: DashboardEventWithUnknownLane[];
};

const { events } = Astro.props;

const closures = events.filter(isClosureEvent);

function closedLengthLabel(event: DashboardEventWithUnknownLane): string | null {
  return typeof event.closedLengthMiles === "number" ? `${event.closedLengthMiles.toFixed(2)} mi` : null;
}
---

<section class="panel" aria-labelledby="closures-detours-heading">
  <h2 class="panel__heading" id="closures-detours-heading">Closures and detours</h2>
  {
    closures.length === 0 ? (
      <p class="empty-note">No closures currently reported.</p>
    ) : (
      <ul class="closure-list">
        {closures.map((event) => (
          <li class="closure-row">
            <div class="closure-row__top">
              <span class="closure-row__title">{event.title}</span>
              <span class="tier-badge tier-badge--alert">Segment closed</span>
            </div>
            <dl class="closure-facts">
              {(event.closureName || event.routeSegmentLabel || event.locationLabel) && (
                <>
                  <dt>Closed section</dt>
                  <dd>{event.closureName ?? event.routeSegmentLabel ?? event.locationLabel}</dd>
                </>
              )}
              {event.closureStartCrossing && (
                <>
                  <dt>From</dt>
                  <dd>{event.closureStartCrossing}</dd>
                </>
              )}
              {event.closureEndCrossing && (
                <>
                  <dt>To</dt>
                  <dd>{event.closureEndCrossing}</dd>
                </>
              )}
              {closedLengthLabel(event) && (
                <>
                  <dt>Closed length</dt>
                  <dd>{closedLengthLabel(event)}</dd>
                </>
              )}
              {typeof event.detourAvailable === "boolean" && (
                <>
                  <dt>Detour</dt>
                  <dd>{event.detourAvailable ? (event.detourDescription ?? "Yes") : "No"}</dd>
                </>
              )}
              {event.closureHours && (
                <>
                  <dt>Closure hours</dt>
                  <dd>{event.closureHours}</dd>
                </>
              )}
              {event.projectedEndDate && (
                <>
                  <dt>Expected reopening</dt>
                  <dd>{event.projectedEndDate}</dd>
                </>
              )}
              {event.sourceName && (
                <>
                  <dt>Source</dt>
                  <dd>
                    {event.sourceUrl ? (
                      <a href={event.sourceUrl} target="_blank" rel="noopener noreferrer">
                        {event.sourceName}
                      </a>
                    ) : (
                      event.sourceName
                    )}
                  </dd>
                </>
              )}
              {formatPacificTime(event.reportedAt) && (
                <>
                  <dt>Reported</dt>
                  <dd>{formatPacificTime(event.reportedAt)}</dd>
                </>
              )}
              {(event as any).johnNote && (
                <>
                  <dt>John Note</dt>
                  <dd>{(event as any).johnNote}</dd>
                </>
              )}
            </dl>
          </li>
        ))}
      </ul>
    )
  }
</section>
