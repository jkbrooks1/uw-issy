---
import type { NormalizedLaneSummary } from "../../lib/route-status/normalize-dashboard-data";
import type { DashboardEventWithUnknownLane } from "../../lib/route-status/types";

type Props = {
  laneSummaries: NormalizedLaneSummary[];
  events: DashboardEventWithUnknownLane[];
};

const { laneSummaries, events } = Astro.props;

const WEATHER_AIR_LANE_IDS = ["02_WEATHER", "03_AIR_QUALITY", "04_WILDFIRE"];
const lanes = laneSummaries.filter((lane) => WEATHER_AIR_LANE_IDS.includes(lane.laneId));
---

<section class="panel" aria-labelledby="weather-air-heading">
  <h2 class="panel__heading" id="weather-air-heading">Weather, air quality, and smoke</h2>
  <p class="empty-note">
    Conditions reflect monitored route areas, not a point-by-point forecast.
  </p>
  <ul class="lane-list">
    {
      lanes.map((lane) => {
        const laneEvents = events.filter((event) => event.laneId === lane.laneId);
        return (
          <li class="lane-row">
            <span class="lane-row__body">
              <span class="lane-row__label">{lane.laneLabel}</span>
              {laneEvents.length === 0 ? (
                <span class="lane-row__meta">No active issues reported</span>
              ) : (
                laneEvents.map((event) => (
                  <span class="lane-row__meta">{event.title}</span>
                ))
              )}
            </span>
          </li>
        );
      })
    }
  </ul>
</section>
