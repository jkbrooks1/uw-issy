---
import type { DashboardEventWithUnknownLane } from "../../lib/route-status/types";
import { formatPacificTime } from "../../lib/route-status/format-time";
import { markerPresentationForEvent } from "../../lib/route-status/event-marker";

type Props = {
  events: DashboardEventWithUnknownLane[];
};

const { events } = Astro.props;
---

<div class="event-list-mobile">
  {
    events.map((event) => (
      <article class="event-card">
        <h3 class="event-card__title">{event.title}</h3>
        <p class="event-card__meta">
          {event.locationLabel ?? event.routeSegmentLabel ?? event.routeSegmentId ?? "Location not stated by source"}
        </p>
        <p class="event-card__meta">
          {formatPacificTime(event.reportedAt) ?? "Report time not stated by source"}
        </p>
        <span class={`tier-badge tier-badge--${event.displayTier}`}>
          <span
            class={`event-marker-inline ${markerPresentationForEvent(event).cssClass}`}
            aria-hidden="true"
          ></span>
          {event.currentStatus === "active" ? "Segment closed" : event.displayTier === "normal" ? "Normal" : event.displayTier === "watch" ? "Caution" : event.displayTier === "alert" ? "Major issue" : "Unknown"}
        </span>
        {event.riderCanPass && (
          <p class="event-card__meta">
            Segment passability <strong>{event.riderCanPass === "no" ? "No" : "Unknown"}</strong>
          </p>
        )}
        {(event as any).johnNote && (
          <div class="john-note-block">
            <strong>John Note</strong>
            <div>{(event as any).johnNote}</div>
          </div>
        )}
      </article>
    ))
  }
</div>
