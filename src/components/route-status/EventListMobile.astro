---
// Buildspec section 24.3 — mobile stacked event list. A real <details>
// disclosure serves as the "clear detail button" — not a hidden whole-card
// click target.
import type { DashboardEventWithUnknownLane } from "../../lib/route-status/types";
import { formatPacificTime } from "../../lib/route-status/format-time";
import { markerPresentationForEvent } from "../../lib/route-status/event-marker";
import EventDetail from "./EventDetail.astro";

type Props = {
  events: DashboardEventWithUnknownLane[];
};

const { events } = Astro.props;
---

<div class="event-list-mobile">
  {
    events.map((event) => (
      <article class="event-card">
        <h3 class="event-card__title">{event.title}</h3>
        <p class="event-card__meta">{event.laneLabel}</p>
        <p class="event-card__meta">
          {event.locationLabel ?? event.routeSegmentLabel ?? event.routeSegmentId ?? "Location not available"}
        </p>
        <p class="event-card__meta">
          {formatPacificTime(event.reportedAt) ?? "Report time not available"}
        </p>
        <span class={`tier-badge tier-badge--${event.displayTier}`}>
          <span
            class={`event-marker-inline ${markerPresentationForEvent(event).cssClass}`}
            aria-hidden="true"
          ></span>
          {event.displayTier}
        </span>
        {event.riderCanPass && (
          <p class="event-card__meta">
            Can I pass? <strong>{event.riderCanPass === "no" ? "No" : "Unknown"}</strong>
          </p>
        )}
        <details>
          <summary class="event-card__link">View details</summary>
          <EventDetail event={event} />
        </details>
      </article>
    ))
  }
</div>
