---
import type { DashboardEventWithUnknownLane } from "../../lib/route-status/types";
import { formatPacificTime } from "../../lib/route-status/format-time";

type Props = {
  event: DashboardEventWithUnknownLane;
};

const { event } = Astro.props;

const reportedLabel = formatPacificTime(event.reportedAt);
const fromLabel = formatPacificTime(event.effectiveFrom);
const untilLabel = formatPacificTime(event.effectiveUntil);
const closedLengthLabel =
  typeof event.closedLengthMiles === "number" ? `${event.closedLengthMiles.toFixed(2)} mi` : null;
---

<dl class="map-popup">
  {event.closureName && (
    <>
      <dt>Closed section</dt>
      <dd>{event.closureName}</dd>
    </>
  )}
  {event.closureStartCrossing && (
    <>
      <dt>From</dt>
      <dd>{event.closureStartCrossing}</dd>
    </>
  )}
  {event.closureEndCrossing && (
    <>
      <dt>To</dt>
      <dd>{event.closureEndCrossing}</dd>
    </>
  )}
  {closedLengthLabel && (
    <>
      <dt>Closed length</dt>
      <dd>{closedLengthLabel}</dd>
    </>
  )}
  {typeof event.detourAvailable === "boolean" && (
    <>
      <dt>Detour</dt>
      <dd>{event.detourAvailable ? (event.detourDescription ?? "Yes") : "No"}</dd>
    </>
  )}
  {event.closureHours && (
    <>
      <dt>Closure hours</dt>
      <dd>{event.closureHours}</dd>
    </>
  )}
  {event.projectedEndDate && (
    <>
      <dt>Expected reopening</dt>
      <dd>{event.projectedEndDate}</dd>
    </>
  )}
  {(event.locationLabel || event.routeSegmentLabel || event.routeSegmentId) && (
    <>
      <dt>Location</dt>
      <dd>{event.locationLabel ?? event.routeSegmentLabel ?? event.routeSegmentId}</dd>
    </>
  )}
  {event.routeEffect && (
    <>
      <dt>Route impact</dt>
      <dd>{event.routeEffect}</dd>
    </>
  )}
  {event.currentStatus && (
    <>
      <dt>Status</dt>
      <dd>{event.currentStatus === "active" ? "Segment closed" : event.currentStatus}</dd>
    </>
  )}
  {event.riderCanPass && (
    <>
      <dt>Segment passability</dt>
      <dd>{event.riderCanPass === "no" ? "No" : "Unknown"}</dd>
    </>
  )}
  {reportedLabel && (
    <>
      <dt>Reported</dt>
      <dd>{reportedLabel}</dd>
    </>
  )}
  {(fromLabel || untilLabel) && (
    <>
      <dt>Effective dates</dt>
      <dd>
        {fromLabel ?? "Start date not stated by source"}
        {untilLabel ? ` through ${untilLabel}` : ""}
      </dd>
    </>
  )}
  {event.sourceName && (
    <>
      <dt>Source</dt>
      <dd>
        {event.sourceUrl ? (
          <a href={event.sourceUrl} target="_blank" rel="noopener noreferrer">
            {event.sourceName}
          </a>
        ) : (
          event.sourceName
        )}
      </dd>
    </>
  )}
</dl>
