---
// Buildspec section 21 — route impacts panel. Never invents route parts;
// only renders what dashboard-data.json actually supplies. Round 2: when
// there is no real route-part breakdown (routeImpacts is null, as it is in
// the current regenerated public/data), this renders a compact single line
// instead of taking prime page space with an empty-looking panel.
import type { RouteImpact } from "../../lib/route-status/types";

type Props = {
  routeImpacts: RouteImpact[] | null;
};

const { routeImpacts } = Astro.props;
const hasImpacts = routeImpacts !== null && routeImpacts.length > 0;
---

{
  !hasImpacts ? (
    <p class="empty-note route-impacts-compact">No route-part breakdown is available in this update.</p>
  ) : (
    <section class="panel" aria-labelledby="route-impacts-heading">
      <h2 class="panel__heading" id="route-impacts-heading">Route impacts</h2>
      <ul class="impact-list">
        {routeImpacts!.map((impact) => (
          <li class="impact-row">
            <div class="impact-row__top">
              <span>{impact.routeSegmentLabel ?? impact.routeSegmentId}</span>
              <span class={`tier-badge tier-badge--${impact.displayTier}`}>
                {impact.displayTier}
              </span>
            </div>
            {impact.effectNote && <p class="impact-row__note">{impact.effectNote}</p>}
          </li>
        ))}
      </ul>
    </section>
  )
}
