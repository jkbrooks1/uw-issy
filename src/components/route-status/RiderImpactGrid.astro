---
import type { RouteWideSummary } from "../../lib/route-status/normalize-dashboard-data";
import { deriveRiderImpactGrid } from "../../lib/route-status/rider-impact-grid";
import type { DashboardEventWithUnknownLane } from "../../lib/route-status/types";

type Props = {
  summary: RouteWideSummary;
  events: DashboardEventWithUnknownLane[];
};

const { summary, events } = Astro.props;
const gridStatus = deriveRiderImpactGrid(summary.laneSummaries, events);

// Arrange four public categories into two tight label/status pairs per row.
const rows = [
  [gridStatus[0], gridStatus[1]],
  [gridStatus[2], gridStatus[3]],
];
---

<section class="panel rider-impact-grid" aria-labelledby="rider-impact-grid-heading">
  <h2 class="panel__heading" id="rider-impact-grid-heading">Route status</h2>
  <div class="rider-impact-grid__container">
    {
      rows.map((row) => (
        <div class="rider-impact-grid__row">
          {row.map((category) => (
            <div class="rider-impact-grid__cell">
              <span class="rider-impact-grid__label">{category.label}</span>
              <div
                class={`rider-impact-grid__ball rider-impact-grid__ball--${category.color}`}
                role="img"
                aria-label={category.ariaLabel}
              />
            </div>
          ))}
        </div>
      ))
    }
  </div>
</section>
