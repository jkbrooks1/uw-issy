---
import type { RouteWideSummary } from "../../lib/route-status/normalize-dashboard-data";

type Props = {
  summary: RouteWideSummary;
};

const { summary } = Astro.props;
---

<div class="dashboard-heading">
  <h1>UW-Issaquah BG/SRT/ELST Status</h1>
  <p class="dashboard-heading__route-label">University of Washington to Issaquah</p>
  {
    summary.lastUpdatedLabel && (
      <p class="dashboard-heading__update">
        <span>
          Updated <strong>{summary.lastUpdatedLabel}</strong>
        </span>
      </p>
    )
  }
</div>
