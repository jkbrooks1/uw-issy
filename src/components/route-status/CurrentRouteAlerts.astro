---
import type { DashboardEventWithUnknownLane } from "../../lib/route-status/types";
import EventTable from "./EventTable.astro";
import EventListMobile from "./EventListMobile.astro";

type Props = {
  events: DashboardEventWithUnknownLane[];
  hasSourceFailures: boolean;
};

const { events } = Astro.props;
---

<section class="panel" aria-labelledby="current-route-alerts-heading">
  <h2 class="panel__heading" id="current-route-alerts-heading">Current route issues</h2>
  {
    events.length === 0 ? (
      <p class="empty-note">No active route issues reported.</p>
    ) : (
      <>
        <EventTable events={events} />
        <EventListMobile events={events} />
      </>
    )
  }
</section>
