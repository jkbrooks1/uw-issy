---
import type { DashboardEventWithUnknownLane } from "../../lib/route-status/types";
import { formatPacificTime } from "../../lib/route-status/format-time";
import { markerPresentationForEvent } from "../../lib/route-status/event-marker";
import EventDetail from "./EventDetail.astro";

type Props = {
  events: DashboardEventWithUnknownLane[];
};

const { events } = Astro.props;

function passabilityLabel(event: DashboardEventWithUnknownLane): string | null {
  if (event.riderCanPass === "no") return "No";
  if (event.riderCanPass === "unknown") return "Unknown";
  return null;
}
---

<div class="event-table-wrap">
  <table class="event-table">
    <caption class="route-map-sr-desc">Current route issues</caption>
    <thead>
      <tr>
        <th scope="col">Event</th>
        <th scope="col">Affected section</th>
        <th scope="col">Reported</th>
        <th scope="col">Status</th>
        <th scope="col">Segment passability</th>
      </tr>
    </thead>
    <tbody>
      {
        events.map((event) => (
          <tr>
            <td>
              <details open={Boolean((event as any).johnNote)}>
                <summary>{event.title}</summary>
                <EventDetail event={event} />
              </details>
            </td>
            <td>{event.locationLabel ?? event.routeSegmentLabel ?? event.routeSegmentId ?? "Location not stated by source"}</td>
            <td>{formatPacificTime(event.reportedAt) ?? "Report time not stated by source"}</td>
            <td>
              <span class={`tier-badge tier-badge--${event.displayTier}`}>
                <span
                  class={`event-marker-inline ${markerPresentationForEvent(event).cssClass}`}
                  aria-hidden="true"
                ></span>
                {event.currentStatus === "active" ? "Segment closed" : event.displayTier === "normal" ? "Normal" : event.displayTier === "watch" ? "Caution" : event.displayTier === "alert" ? "Major issue" : "Unknown"}
              </span>
            </td>
            <td>{event.riderCanPass ? passabilityLabel(event) : ""}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
