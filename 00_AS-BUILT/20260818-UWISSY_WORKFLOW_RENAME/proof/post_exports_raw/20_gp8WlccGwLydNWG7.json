e.readWriteFile","typeVersion":1,"position":[940,0],"onError":"continueRegularOutput","alwaysOutputData":true,"parameters":{"operation":"read","fileSelector":"={{ $json.artifact_path || '__no_artifact_yet__' }}","options":{}}},{"id":"parse_07_government_safety_alerts","name":"Parse 07_GOVERNMENT_SAFETY_ALERTS Status","type":"n8n-nodes-base.code","typeVersion":2,"position":[1180,0],"parameters":{"mode":"runOnceForAllItems","jsCode":"const helpers = this.helpers;\nconst laneId = '07_GOVERNMENT_SAFETY_ALERTS';\nconst laneLabel = 'Government Safety Alerts';\nlet parsed = null;\nlet available = false;\ntry {\n  const item = $input.first();\n  if (item.binary && item.binary.data) {\n    const buffer = await helpers.getBinaryDataBuffer(0, 'data');\n    const text = buffer.toString('utf8');\n    const candidate = JSON.parse(text);\n    if (candidate && typeof candidate === 'object') { parsed = candidate; available = true; }\n  }\n} catch (error) {\n  parsed = null;\n  available = false;\n}\nreturn [{ json: { lane_id: laneId, lane_label: laneLabel, available, data: parsed } }];"}},{"id":"merge_lanes","name":"Merge Lane Status","type":"n8n-nodes-base.merge","typeVersion":3,"position":[940,0],"parameters":{"numberInputs":7}},{"id":"aggregate_lanes","name":"Aggregate All Lanes","type":"n8n-nodes-base.code","typeVersion":2,"position":[1180,0],"parameters":{"mode":"runOnceForAllItems","jsCode":"const items = $input.all().map(i => i.json);\nconst run = $('Initialize Run Metadata').first().json;\n\nfunction displaySeverity(dataStatus) {\n  if (dataStatus === 'blocked') return 'alert';\n  if (['degraded', 'stale', 'failed_fetch', 'using_last_known_good', 'failed_validation'].includes(dataStatus)) return 'watch';\n  if (dataStatus === 'ok' || dataStatus === 'no_relevant_events') return 'normal';\n  return 'unknown';\n}\nconst severityRank = { normal: 0, unknown: 1, watch: 2, alert: 3 };\n\nconst lanes = {};\nlet worst = 'normal';\nfor (const item of items) {\n  const laneId = item.lane_id;\n  if (!item.available || !item.data) {\n    lanes[laneId] = {\n      lane_label: item.lane_label,\n      available: false,\n      display_severity: 'unknown',\n      data_status: null,\n      message: 'No published data yet for this lane.'\n    };\n    if (severityRank['unknown'] > severityRank[worst]) worst = 'unknown';\n    continue;\n  }\n  const d = item.data;\n  const sev = displaySeverity(d.data_status);\n  lanes[laneId] = {\n    lane_label: item.lane_label,\n    available: true,\n    display_severity: sev,\n    data_status: d.data_status || null,\n    freshness: d.freshness || null,\n    published_at: d.published_at || null,\n    generated_at: d.generated_at || null,\n    connector_health: d.connector_health || null,\n    event_count: Array.isArray(d.events) ? d.events.length : (Array.isArray(d.deduplicated_events) ? d.deduplicated_events.length : 0),\n    events: d.events || d.deduplicated_events || []\n  };\n  if (severityRank[sev] > severityRank[worst]) worst = sev;\n}\n\nconst overallMessage = worst === 'alert' ? 'One or more lanes report a blocked or route-impacting condition.'\n  : worst === 'watch' ? 'One or more lanes are degraded, stale, or running on last-known-good data.'\n  : worst === 'unknown' ? 'One or more lanes have not published data yet.'\n  : 'All lanes reporting normally.';\n\nreturn [{ json: {\n  schema_version: '1.0.0',\n  connector_id: '20_STATUS_PUBLISHER',\n  generated_at: run.generated_at,\n  run_id: run.run_id,\n  overall: { display_severity: worst, message: overallMessage },\n  lanes: lanes,\n  severity_mapping_note: 'display_severity is a workflow-20-only display tier per DEC-009; each lane\\'s native data_status and events are preserved verbatim above.'\n} }];"}},{"id":"build_public_artifact","name":"Build Public Status Artifact","type":"n8n-nodes-base.code","typeVersion":2,"position":[1420,0],"parameters":{"mode":"runOnceForAllItems","jsCode":"const helpers = this.helpers;\nconst run = $('Initialize Run Metadata').first