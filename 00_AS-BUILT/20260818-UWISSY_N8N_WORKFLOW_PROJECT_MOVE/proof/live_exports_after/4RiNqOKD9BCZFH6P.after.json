: { file_path: filePath, source_id: landing.source_id, source_name: landing.source_name, content_hash: contentHash, retrieved_at: run.generated_at }, binary: { data: binary } }];\n"}},{"id":"write_WSDOT-01","name":"Write WSDOT-01 Raw Landing","type":"n8n-nodes-base.readWriteFile","typeVersion":1,"position":[760,1950],"parameters":{"operation":"write","fileName":"={{ $json.file_path }}","dataPropertyName":"data","options":{}}},{"id":"normalize_WSDOT-01","name":"Normalize WSDOT-01 Events","type":"n8n-nodes-base.code","typeVersion":2,"position":[1010,1950],"parameters":{"mode":"runOnceForAllItems","jsCode":"\nconst hashString = (input) => { let hash = 2166136261; for (let i = 0; i < input.length; i++) { hash ^= input.charCodeAt(i); hash = Math.imul(hash, 16777619); } return (hash >>> 0).toString(16).padStart(8, '0'); };\nconst safeJson = (value) => { try { return typeof value === 'string' ? JSON.parse(value) : value; } catch { return null; } };\nconst pickText = (...parts) => parts.filter(Boolean).map(value => typeof value === 'string' ? value : JSON.stringify(value)).join(' | ');\n\nconst run = $('Initialize Run Metadata').first().json;\nconst fetch = $('Fetch WSDOT-01 Alerts').first().json || {};\nconst landing = $('Land WSDOT-01 Raw Payload').first().json || {};\nconst raw = fetch.body !== undefined ? fetch.body : (landing.body !== undefined ? landing.body : fetch);\nconst rawText = typeof raw === 'string' ? raw : JSON.stringify(raw ?? null);\nconst rawObj = safeJson(rawText);\nconst lkg = ($('Parse Last Known Good').first().json.bySource || {})['05_FLOOD_CONDITIONS:WSDOT-01'];\nlet events = [];\nlet observations = [];\nlet warnings = [];\nlet errors = [];\nlet sourceHealth;\nlet lastObservationAt = run.generated_at;\nconst liveFailed = !!fetch.error;\nconst liveErrorMessage = liveFailed ? String(fetch.error.message || fetch.error) : '';\n\nif (!run.runtime_flags.wsdot_access_code_present) {\n  sourceHealth = {\n    schema_version: '1.0.0',\n    connector_id: run.connector_id,\n    source_id: '05_FLOOD_CONDITIONS:WSDOT-01',\n    source_name: \"WSDOT Traveler Information API - Highway Alerts\",\n    status: 'not_run',\n    retrieved_at: run.generated_at,\n    stale_after_minutes: 60,\n    record_count: 0,\n    http_status: null,\n    last_observation_at: null,\n    warnings: ['WSDOT_TRAVELER_API_ACCESS_CODE is not set; source skipped.'],\n    errors: []\n  };\n} else if (!liveFailed) {\n  const records = Array.isArray(rawObj) ? rawObj : (Array.isArray(rawObj?.alerts) ? rawObj.alerts : (Array.isArray(rawObj?.value) ? rawObj.value : []));\n  for (const record of records) {\n    const text = pickText(record.AlertID || record.HeadlineDescription || record.EventCategory || record.EventStatus || record.County || record.StartTime || record.EndTime || record.Description);\n    const lower = text.toLowerCase();\n    if (!/sr-522|i-405|road|highway|detour|closure|flood|water|washout|drainage/.test(lower)) continue;\n    const observedAt = record.LastUpdatedTime || record.StartTime || run.generated_at;\n    const routeImpact = /closure|detour/.test(lower) ? 'confirmed_route_closure' : 'probable_route_impact';\n    events.push({\n      event_id: '05_FLOOD_CONDITIONS:WSDOT-01:' + hashString(pickText(text, observedAt)),\n      event_type: 'closure_confirmation',\n      status: String(record.EventStatus || 'active').toLowerCase(),\n      severity: /severe|major|warning/.test(lower) ? 'warning' : 'watch',\n      route_impact: routeImpact,\n      title: record.HeadlineDescription || record.EventCategory || 'WSDOT highway alert',\n      summary: pickText(record.HeadlineDescription || '', record.Description || '', record.County || ''),\n      source_id: '05_FLOOD_CONDITIONS:WSDOT-01',\n      source_event_ref: record.AlertID || null,\n      observed_at: observedAt,\n      effective_until: record.EndTime || null,\n      official_category: record.EventCategory || null,\n      metric: null,\n      location: {\n        name: record.County || 'WSDOT highway segment',\n        latitude: null,\n        longitude: null,\n        route_section_ids: [\"03_burke_gilman_north_lake_wa_kenmore\",\"04_burke_gilman_connector_bothell\",\"05_sammamish_river_trail_bothell_woodinville\",\"06_sammamish_river_trail_redmond\",\"07_marymoor_park\",\"08_east_lake_sammamish_trail_redmond\",\"09_east_lake_sammamish_trail_sammamish\"]\n      },\n      route_relevance: {\n        method: \"roadway_match\",\n        distance_km: 0,\n        confidence: 'medium',\n        reason: \"State highway crossing and detour supplement only.\"\n      },\n      provenance: {\n        source_url: 'https://wsdot.wa.gov/Traffic/api/HighwayAlerts/HighwayAlertsREST.svc/GetAlertsAsJson',\n        retrieved_at: run.generated_at,\n        source_record_hash: 'hash_' + hashString(JSON.stringify(record))\n      }\n    });\n    lastObservationAt = observedAt;\n  }\n  if (!records.length) {\n    warnings.push('WSDOT returned a valid empty array.');\n  }\n}\n\nif (liveFailed) {\n  const lkgRetrievedAt = lkg && lkg.source_health && lkg.source_health.retrieved_at ? Date.parse(lkg.source_health.retrieved_at) : NaN;\n  const lkgStaleAfterMinutes = lkg && lkg.source_health && lkg.source_health.stale_after_minutes !== undefined ? lkg.source_health.stale_after_minutes : 60;\n  const lkgUsable = !!lkg && Number.isFinite(lkgRetrievedAt) && ((Date.now() - lkgRetrievedAt) / 60000) <= lkgStaleAfterMinutes;\n  if (lkgUsable) {\n    events = Array.isArray(lkg.events) ? lkg.events : [];\n    observations = Array.isArray(lkg.observations) ? lkg.observations : [];\n    sourceHealth = {\n      schema_version: '1.0.0',\n      connector_id: run.connector_id,\n      source_id: '05_FLOOD_CONDITIONS:WSDOT-01',\n      source_name: \"WSDOT Traveler Information API - Highway Alerts\",\n      status: 'using_last_known_good',\n      retrieved_at: lkg.source_health.retrieved_at,\n      stale_after_minutes: 60,\n      record_count: events.length + observations.length,\n      http_status: null,\n      last_observation_at: lkg.source_health.last_observation_at ?? lkg.source_health.retrieved_at,\n      warnings: [...(lkg.source_health.warnings || []), 'Live fetch failed; serving last-known-good data retrieved at ' + lkg.source_health.retrieved_at + '.'],\n      errors: [liveErrorMessage]\n    };\n  } else {\n    sourceHealth = {\n      schema_version: '1.0.0',\n      connector_id: run.connector_id,\n      source_id: '05_FLOOD_CONDITIONS:WSDOT-01',\n      source_name: \"WSDOT Traveler Information API - Highway Alerts\",\n      status: 'failed',\n      retrieved_at: run.generated_at,\n      stale_after_minutes: 60,\n      record_count: 0,\n      http_status: fetch.statusCode ?? fetch.status ?? null,\n      last_observation_at: run.generated_at,\n      warnings: ['Live fetch failed and no usable last-known-good snapshot was available.'],\n      errors: [liveErrorMessage]\n    };\n  }\n}\n\n\nif (!sourceHealth) {\n  sourceHealth = {\n    schema_version: '1.0.0',\n    connector_id: run.connector_id,\n    source_id: '05_FLOOD_CONDITIONS:WSDOT-01',\n    source_name: \"WSDOT Traveler Information API - Highway Alerts\",\n    status: events.length ? 'ok' : 'empty_but_valid',\n    retrieved_at: run.generated_at,\n    stale_after_minutes: 60,\n    record_count: events.length + observations.length,\n    http_status: fetch.statusCode ?? fetch.status ?? null,\n    last_observation_at: lastObservationAt,\n    warnings: warnings,\n    errors: errors\n  };\n}\n\nreturn [{\n  json: {\n    source_id: '05_FLOOD_CONDITIONS:WSDOT-01',\n    source_name: \"WSDOT Traveler Information API - Highway Alerts\",\n    source_health: sourceHealth,\n    events,\n    observations,\n    raw_landing_path: landing.file_path || null,\n    raw_content_hash: landing.content_hash || ('hash_' + hashString(rawText)),\n    warnings,\n    errors: sourceHealth.errors\n  }\n}];\n"}},{"id":"merge_normalized_branches","name":"Merge Normalized Branches","type":"n8n-nodes-base.merge","typeVersion":3.1,"position":[1260,760],"parameters":{"numberInputs":10}},{"id":"aggregate_normalized_branches","name":"Aggregate Normalized Branches","type":"n8n-nodes-base.code","typeVersion":2,"position":[1520,760],"parameters":{"mode":"runOnceForAllItems","jsCode":"\nconst run = $('Initialize Run Metadata').first().json;\nconst inputs = $input.all().map(item => item.json || {});\nconst events = inputs.flatMap(item => Array.isArray(item.events) ? item.events : []);\nconst observations = inputs.flatMap(item => Array.isArray(item.observations) ? item.observations : []);\nconst sourceHealth = inputs.map(item => item.source_health).filter(Boolean);\nconst sourceWarnings = inputs.flatMap(item => Array.isArray(item.warnings) ? item.warnings : []);\nconst sourceErrors = inputs.flatMap(item => Array.isArray(item.errors) ? item.errors : []);\nconst sourceIds = inputs.map(item => item.source_id).filter(Boolean);\nconst sourcePayloadRefs = inputs.map(item => item.raw_landing_path).filter(Boolean);\nreturn [{\n  json: {\n    schema_version: run.schema_version,\n    connector_id: run.connector_id,\n    connector_name: run.connector_name,\n    connector_version: run.connector_version,\n    lane: run.lane,\n    run_id: run.run_id,\n    run_stamp: run.run_stamp,\n    generated_at: run.generated_at,\n    published_at: null,\n    output_root: run.output_root,\n    canonical_gpx: run.canonical_gpx,\n    manifest_ref: run.manifest_ref,\n    route_sections: run.route_sections,\n    source_health: sourceHealth,\n    events: events,\n    observations: observations,\n    provenance: {\n      source_ids_used: sourceIds,\n      route_gpx_ref: run.canonical_gpx,\n      source_payload_refs: sourcePayloadRefs,\n      normalization_notes: sourceWarnings.length ? sourceWarnings : ['Normalized from live source branches.']\n    },\n    source_warnings: sourceWarnings,\n    source_errors: sourceErrors,\n    source_items: inputs\n  }\n}];\n"}},{"id":"deduplicate_events","name":"Deduplicate Events","type":"n8n-nodes-base.code","typeVersion":2,"position":[1760,760],"parameters":{"mode":"runOnceForAllItems","jsCode":"\nconst input = $input.first().json;\nconst seen = new Map();\nconst deduplicatedEvents = [];\nconst duplicateEvents = [];\nfor (const event of input.events || []) {\n  const key = [\n    event.source_id,\n    event.event_type,\n    event.status,\n    event.summary,\n    event.source_event_ref || '',\n    event.observed_at || '',\n    event.effective_until || ''\n  ].join('|');\n  if (seen.has(key)) {\n    duplicateEvents.push(event);\n    continue;\n  }\n  seen.set(key, true);\n  deduplicatedEvents.push(event);\n}\nconst seenObs = new Map();\nconst deduplicatedObservations = [];\nconst duplicateObservations = [];\nfor (const observation of input.observations || []) {\n  const key = [\n    observation.source_id,\n    observation.observation_type,\n    observation.title,\n    observation.observed_at || ''\n  ].join('|');\n  if (seenObs.has(key)) {\n    duplicateObservations.push(observation);\n    continue;\n  }\n  seenObs.set(key, true);\n  deduplicatedObservations.push(observation);\n}\nreturn [{ json: { ...input, events_before_dedup: (input.events || []).length, deduplicated_events: deduplicatedEvents, duplicate_events: duplicateEvents, observations_before_dedup: (input.observations || []).length, deduplicated_observations: deduplicatedObservations, duplicate_observations: duplicateObservations, dedup_valid: true } }];\n"}},{"id":"build_route_sections","name":"Build Route Sections Rollups","type":"n8n-nodes-base.code","typeVersion":2,"position":[2000,760],"parameters":{"mode":"runOnceForAllItems","jsCode":"\nconst input = $input.first().json;\nconst sectionMap = {};\nfor (const [route_section_id, route_section_name] of [[\"01_uw_u_district\",\"UW / U-District\"],[\"02_burke_gilman_seattle\",\"Burke-Gilman - Seattle\"],[\"03_burke_gilman_north_lake_wa_kenmore\",\"Burke-Gilman - north Lake WA/Kenmore\"],[\"04_burke_gilman_connector_bothell\",\"Burke-Gilman/connector - Bothell\"],[\"05_sammamish_river_trail_bothell_woodinville\",\"Sammamish River Trail - Bothell/Woodinville\"],[\"06_sammamish_river_trail_redmond\",\"Sammamish River Trail - Redmond\"],[\"07_marymoor_park\",\"Marymoor Park\"],[\"08_east_lake_sammamish_trail_redmond\",\"East Lake Sammamish Trail - Redmond\"],[\"09_east_lake_sammamish_trail_sammamish\",\"East Lake Sammamish Trail - Sammamish\"],[\"10_issaquah_approach_terminus\",\"Issaquah approach / terminus\"]]) {\n  sectionMap[route_section_id] = {\n    route_section_id,\n    route_section_name,\n    status: 'no_current_events',\n    event_ids: [],\n    observation_ids: [],\n    updated_at: input.generated_at\n  };\n}\nconst records = [\n  ...(input.deduplicated_events || []).map(item => ({ ...item, kind: 'event' })),\n  ...(input.deduplicated_observations || []).map(item => ({ ...item, kind: 'observation' }))\n];\nfor (const record of records) {\n  const sectionIds = Array.isArray(record.route_section_ids) ? record.route_section_ids : Array.isArray(record.route_sections) ? record.route_sections : [];\n  for (const sectionId of sectionIds) {\n    const section = sectionMap[sectionId];\n    if (!section) continue;\n    section.updated_at = input.generated_at;\n    if (record.kind === 'event') {\n      section.event_ids.push(record.event_id);\n      if (record.route_impact === 'confirmed_route_closure') {\n        section.status = 'active_closure';\n      } else if (['observed_flooding', 'forecast_flooding', 'probable_route_impact', 'warning'].includes(record.route_impact) && section.status !== 'active_closure') {\n        section.status = 'watch';\n      } else if (record.route_impact === 'elevated_water' && section.status === 'no_current_events') {\n        section.status = 'monitoring';\n      }\n    } else {\n      section.observation_ids.push(record.observation_id);\n      if (section.status === 'no_current_events') {\n        section.status = 'monitoring';\n      }\n    }\n  }\n}\nreturn [{ json: { ...input, route_sections: Object.values(sectionMap) } }];\n"}},{"id":"validate_candidate_envelope","name":"Validate Candidate Envelope","type":"n8n-nodes-base.code","typeVersion":2,"position":[2240,760],"parameters":{"mode":"runOnceForAllItems","jsCode":"\nconst input = $input.first().json;\nconst errors = [];\nconst warnings = [];\nconst requiredRootFields = ['schema_version', 'connector_id', 'connector_name', 'connector_version', 'lane', 'run_id', 'generated_at', 'output_root', 'canonical_gpx', 'manifest_ref'];\nfor (const field of requiredRootFields) {\n  if (!(field in input) || input[field] === null || input[field] === undefined || input[field] === '') errors.push('Missing required root field: ' + field);\n}\nif (!Array.isArray(input.source_health)) errors.push('source_health must be an array');\nif (!Array.isArray(input.deduplicated_events)) errors.push('deduplicated_events must be an array');\nif (!Array.isArray(input.deduplicated_observations)) errors.push('deduplicated_observations must be an array');\nif (!Array.isArray(input.route_sections)) errors.push('route_sections must be an array');\nconst allowedSourceStatuses = ['ok', 'degraded', 'failed', 'stale', 'blocked', 'not_run', 'skipped_as_not_due', 'empty_but_valid', 'using_last_known_good'];\nconst allowedEventTypes = ['gauge_observation', 'gauge_forecast', 'nws_alert', 'closure_confirmation', 'policy_threshold', 'derived_context'];\nconst allowedEventStatuses = ['active', 'monitoring', 'scheduled', 'resolved', 'expired'];\nconst allowedSeverities = ['info', 'advisory', 'watch', 'warning', 'severe'];\nconst allowedRouteImpact = ['no_known_route_impact', 'elevated_water', 'watch', 'probable_route_impact', 'forecast_flooding', 'observed_flooding', 'warning', 'confirmed_route_closure'];\nfor (const event of input.deduplicated_events || []) {\n  const fields = ['event_id', 'event_type', 'status', 'severity', 'route_impact', 'title', 'summary', 'source_id', 'observed_at', 'location', 'route_relevance', 'provenance'];\n  for (const field of fields) {\n    if (!(field in event) || event[field] === null || event[field] === undefined || event[field] === '') {\n      errors.push('Event missing required field: ' + field + ' (' + (event.event_id || 'unknown') + ')');\n    }\n  }\n  if (!allowedEventTypes.includes(event.event_type)) errors.push('Invalid event_type: ' + event.event_type + ' (' + event.event_id + ')');\n  if (!allowedEventStatuses.includes(event.status)) errors.push('Invalid event status: ' + event.status + ' (' + event.event_id + ')');\n  if (!allowedSeverities.includes(event.severity)) errors.push('Invalid event severity: ' + event.severity + ' (' + event.event_id + ')');\n  if (!allowedRouteImpact.includes(event.route_impact)) errors.push('Invalid route_impact: ' + event.route_impact + ' (' + event.event_id + ')');\n}\nfor (const obs of input.deduplicated_observations || []) {\n  const fields = ['observation_id', 'observation_type', 'title', 'summary', 'source_id', 'observed_at'];\n  for (const field of fields) {\n    if (!(field in obs) || obs[field] === null || obs[field] === undefined || obs[field] === '') {\n      errors.push('Observation missing required field: ' + field + ' (' + (obs.observation_id || 'unknown') + ')');\n    }\n  }\n}\nfor (const source of input.source_health || []) {\n  const fields = ['schema_version', 'connector_id', 'source_id', 'source_name', 'status', 'retrieved_at', 'stale_after_minutes', 'record_count', 'http_status', 'last_observation_at', 'warnings', 'errors'];\n  for (const field of fields) {\n    if (!(field in source) || source[field] === undefined) {\n      errors.push('Source health missing field: ' + field + ' (' + (source.source_id || 'unknown') + ')');\n    }\n  }\n  if (source.status && !allowedSourceStatuses.includes(source.status)) {\n    errors.push('Invalid source health status: ' + source.status + ' (' + (source.source_id || 'unknown') + ')');\n  }\n}\nconst candidateValidationPassed = errors.length === 0;\nif (!candidateValidationPassed) warnings.push('Validation failed; candidate will be quarantined and published output suppressed.');\nreturn [{ json: { ...input, validation_errors: errors, validation_warnings: warnings, candidate_validation_passed: candidateValidationPassed, validator_version: '1.0.0', validation_state: { schema_valid: candidateValidationPassed, freshness_valid: candidateValidationPassed, dedup_valid: true, published_from_candidate: false, validator_version: '1.0.0' } } }];\n"}},{"id":"build_candidate_artifact","name":"Build Candidate Artifact","type":"n8n-nodes-base.code","typeVersion":2,"position":[2480,760],"parameters":{"mode":"runOnceForAllItems","jsCode":"\nconst input = $input.first().json;\nconst sourceStatuses = (input.source_health || []).map(source => source.status);\nconst anyFailed = sourceStatuses.some(status => status === 'failed');\nconst anyStale = sourceStatuses.some(status => status === 'stale' || status === 'using_last_known_good');\nconst anyLkg = sourceStatuses.some(status => status === 'using_last_known_good');\nconst allFailed = (input.source_health || []).length > 0 && sourceStatuses.every(status => status === 'failed');\nconst allLkg = sourceStatuses.length > 0 && sourceStatuses.every(status => status === 'using_last_known_good');\nconst hasEvents = (input.deduplicated_events || []).length > 0;\nlet dataStatus = 'ok';\nif (!input.candidate_validation_passed) dataStatus = 'failed_validation'; else if (allFailed) dataStatus = 'failed_fetch'; else if (allLkg) dataStatus = 'using_last_known_good'; else if (!hasEvents && !anyFailed && !anyStale) dataStatus = 'no_relevant_events'; else if (anyFailed || anyStale) dataStatus = 'degraded';\nconst freshnessState = allFailed ? 'unknown' : (anyFailed || anyStale ? 'stale' : 'fresh');\nconst staleSourceIds = (input.source_health || []).filter(source => source.status === 'stale' || source.status === 'using_last_known_good').map(source => source.source_id);\nconst oldestRelevantAgeMinutes = (() => {\n  const ages = (input.source_health || []).map(source => {\n    const ts = Date.parse(source.retrieved_at || '');\n    return Number.isFinite(ts) ? Math.max(0, Math.round((Date.parse(input.generated_at) - ts) / 60000)) : null;\n  }).filter(value => value !== null);\n  return ages.length ? Math.max(...ages) : 0;\n})();\nconst candidateEnvelope = {\n  schema_version: input.schema_version,\n  connector_id: input.connector_id,\n  connector_name: input.connector_name,\n  connector_version: input.connector_version,\n  lane: input.lane,\n  run_id: input.run_id,\n  generated_at: input.generated_at,\n  published_at: null,\n  data_status: dataStatus,\n  freshness: {\n    overall_state: freshnessState,\n    computed_at: input.generated_at,\n    oldest_relevant_source_age_minutes: oldestRelevantAgeMinutes,\n    stale_source_ids: staleSourceIds\n  },\n  manifest_ref: input.manifest_ref,\n  source_health: input.source_health || [],\n  connector_health: {\n    schema_version: '1.0.0',\n    connector_id: input.connector_id,\n    status: input.candidate_validation_passed ? (anyFailed || anyStale ? 'degraded' : 'ok') : 'failed',\n    failed_stage: input.candidate_validation_passed ? null : 'validation',\n    warning_count: (input.validation_warnings || []).length + (input.source_warnings || []).length,\n    error_count: (input.validation_errors || []).length + (input.source_errors || []).length,\n    used_last_known_good: anyLkg,\n    candidate_written: true,\n    published_written: false\n  },\n  events: input.deduplicated_events || [],\n  observations: input.deduplicated_observations || [],\n  route_sections: input.route_sections || [],\n  provenance: {\n    source_ids_used: (input.source_health || []).map(source => source.source_id),\n    route_gpx_ref: input.canonical_gpx,\n    source_payload_refs: (input.source_items || []).map(item => item.raw_landing_path).filter(Boolean),\n    normalization_notes: (input.validation_warnings || []).concat(input.source_warnings || [])\n  },\n  validation_state: {\n    schema_valid: input.candidate_validation_passed,\n    freshness_valid: freshnessState !== 'unknown',\n    dedup_valid: input.dedup_valid !== false,\n    candidate_validation_passed: input.candidate_validation_passed,\n    published_from_candidate: false,\n    validator_version: input.validator_version || '1.0.0'\n  },\n  metadata: {\n    coverage_limitations: input.coverage_limitations || [],\n    optional_sources_not_run: (input.source_health || []).filter(source => source.status === 'not_run').map(source => source.source_id),\n    stale_data_fields: staleSourceIds,\n    source_warnings: input.source_warnings || [],\n    source_errors: input.source_errors || []\n  }\n};\nconst normalizedPath = input.output_root + '/normalized/05_FLOOD_CONDITIONS/05_FLOOD_CONDITIONS_normalized_output_' + input.run_stamp + '.json';\nconst candidatePath = input.output_root + '/candidate/05_FLOOD_CONDITIONS/05_FLOOD_CONDITIONS_candidate_' + input.run_stamp + '.json';\nconst normalizedBuffer = Buffer.from(JSON.stringify(candidateEnvelope, null, 2), 'utf8');\nconst candidateBuffer = Buffer.from(JSON.stringify(candidateEnvelope, null, 2), 'utf8');\nconst normalizedBinary = await this.helpers.prepareBinaryData(normalizedBuffer, normalizedPath.split('/').pop(), 'application/json');\nconst candidateBinary = await this.helpers.prepareBinaryData(candidateBuffer, candidatePath.split('/').pop(), 'application/json');\nreturn [\n  { json: { file_path: normalizedPath, file_name: normalizedPath.split('/').pop(), artifact_type: 'normalized', candidate_envelope: candidateEnvelope }, binary: { data: normalizedBinary } },\n  { json: { file_path: candidatePath, file_name: candidatePath.split('/').pop(), artifact_type: 'candidate', candidate_envelope: candidateEnvelope }, binary: { data: candidateBinary } }\n];\n"}},{"id":"write_candidate_artifact","name":"Write Candidate Artifact","type":"n8n-nodes-base.readWriteFile","typeVersion":1,"position":[2720,760],"parameters":{"operation":"write","fileName":"={{ $json.file_path }}","dataPropertyName":"data","options":{}}},{"id":"publish_gate_decision","name":"Publish Gate Decision","type":"n8n-nodes-base.code","typeVersion":2,"position":[2960,760],"parameters":{"mode":"runOnceForAllItems","jsCode":"\nconst candidate = $('Build Candidate Artifact').first().json.candidate_envelope;\nconst validation = $('Validate Candidate Envelope').first().json;\nconst shouldPublish = !!validation.candidate_validation_passed;\nconst reason = shouldPublish ? 'Validation passed' : 'Validation failed: ' + (validation.validation_errors || []).join('; ');\nreturn [{ json: { should_publish: shouldPublish, reason, candidate_envelope: candidate, validation_errors: validation.validation_errors || [], validation_warnings: validation.validation_warnings || [], run_id: validation.run_id, run_stamp: validation.run_stamp, output_root: validation.output_root, connector_id: validation.connector_id, connector_name: validation.connector_name, connector_version: validation.connector_version, lane: validation.lane, generated_at: validation.generated_at, source_health: validation.source_health || [], deduplicated_events: validation.deduplicated_events || [], deduplicated_observations: validation.deduplicated_observations || [], route_sections: validation.route_sections || [], freshness: validation.freshness || null, provenance: validation.provenance || null } }];\n"}},{"id":"build_final_artifact_bundle","name":"Build Final Artifact Bundle","type":"n8n-nodes-base.code","typeVersion":2,"position":[3200,760],"parameters":{"mode":"runOnceForAllItems","jsCode":"\nconst hashString = (input) => { let hash = 2166136261; for (let i = 0; i < input.length; i++) { hash ^= input.charCodeAt(i); hash = Math.imul(hash, 16777619); } return (hash >>> 0).toString(16).padStart(8, '0'); };\nconst gate = $input.first().json;\nconst candidateEnvelope = gate.candidate_envelope || $('Build Candidate Artifact').first().json.candidate_envelope;\nconst runStamp = gate.run_stamp || candidateEnvelope.generated_at.replace(/[-:]/g, '').replace(/\\.\\d{3}Z$/, 'Z');\nconst now = new Date().toISOString();\nconst outputRoot = gate.output_root || '/files/uw-issy-connectors';\nconst runId = gate.run_id || candidateEnvelope.run_id;\nconst publishedPath = outputRoot + '/published/05_FLOOD_CONDITIONS/05_FLOOD_CONDITIONS_published_' + runStamp + '.json';\nconst publishedCurrentPath = outputRoot + '/published/05_FLOOD_CONDITIONS/current.json';\nconst lkgCurrentPath = outputRoot + '/last_known_good/05_FLOOD_CONDITIONS/current.json';\nconst lkgArchivePath = outputRoot + '/last_known_good/05_FLOOD_CONDITIONS/archive/' + runStamp + '.json';\nconst validationLogPath = outputRoot + '/logs/05_FLOOD_CONDITIONS/validation_log_' + runStamp + '.jsonl';\nconst statusPath = outputRoot + '/health/05_FLOOD_CONDITIONS/status.json';\nconst statusArchivePath = outputRoot + '/health/05_FLOOD_CONDITIONS/status_' + runStamp + '.json';\nconst executionEvidencePath = outputRoot + '/health/05_FLOOD_CONDITIONS/execution_evidence_' + runStamp + '.json';\nconst handoffPath = outputRoot + '/handoff/05_FLOOD_CONDITIONS/05_FLOOD_CONDITIONS_handoff_' + runStamp + '.json';\nconst quarantinePath = outputRoot + '/health/05_FLOOD_CONDITIONS/quarantine_' + runStamp + '.json';\nconst validationErrors = gate.validation_errors || [];\nconst validationWarnings = gate.validation_warnings || [];\nconst sourceHealth = gate.source_health || [];\nconst sourceStatuses = sourceHealth.map(source => source.status);\nconst anyFailed = sourceStatuses.some(status => status === 'failed');\nconst anyStale = sourceStatuses.some(status => status === 'stale' || status === 'using_last_known_good');\nconst anyLkg = sourceStatuses.some(status => status === 'using_last_known_good');\nconst allFailed = sourceHealth.length > 0 && sourceStatuses.every(status => status === 'failed');\nconst allLkg = sourceStatuses.length > 0 && sourceStatuses.every(status => status === 'using_last_known_good');\nconst hasEvents = (gate.deduplicated_events || []).length > 0;\nconst publishedArtifactRef = gate.should_publish ? publishedPath : null;\nconst statusValue = gate.should_publish ? (anyFailed || anyStale ? 'degraded' : 'ok') : (validationErrors.length ? 'failed' : (allFailed ? 'failed' : 'degraded'));\nlet dataStatus = 'ok';\nif (allFailed) dataStatus = 'failed_fetch'; else if (allLkg) dataStatus = 'using_last_known_good'; else if (!hasEvents && !anyFailed && !anyStale) dataStatus = 'no_relevant_events'; else if (anyFailed || anyStale) dataStatus = 'degraded';\nconst publishedEnvelope = gate.should_publish ? {\n  ...candidateEnvelope,\n  published_at: now,\n  data_status: dataStatus,\n  connector_health: {\n    ...candidateEnvelope.connector_health,\n    status: anyFailed || anyStale ? 'degraded' : 'ok',\n    failed_stage: null,\n    candidate_written: true,\n    published_written: true,\n    used_last_known_good: anyLkg\n  },\n  validation_state: {\n    ...candidateEnvelope.validation_state,\n    candidate_validation_passed: true,\n    published_from_candidate: true\n  },\n  freshness: {\n    ...candidateEnvelope.freshness,\n    overall_state: anyFailed || anyStale ? 'stale' : 'fresh',\n    computed_at: now\n  }\n} : null;\nconst statusDoc = {\n  lane_id: '05_FLOOD_CONDITIONS',\n  last_fetch_at: gate.generated_at || candidateEnvelope.generated_at,\n  last_success_at: gate.should_publish ? now : null,\n  status: statusValue,\n  source_health: sourceHealth,\n  error_messages: validationErrors.concat(gate.source_errors || []),\n  stale_data_fields: (gate.freshness && gate.freshness.stale_source_ids) || sourceHealth.filter(source => source.status === 'stale' || source.status === 'using_last_known_good').map(source => source.source_id),\n  published_artifact_ref: publishedArtifactRef,\n  last_known_good_ref: lkgCurrentPath\n};\nconst handoffDoc = {\n  schema_version: '1.0.0',\n  connector_id: gate.connector_id,\n  lane: gate.lane || candidateEnvelope.lane,\n  run_id: runId,\n  handoff_generated_at: now,\n  connector_output_path: gate.should_publish ? publishedPath : quarantinePath,\n  manifest_path: '/files/uw-issy-connectors/manifests/05_FLOOD_CONDITIONS/05_FLOOD_CONDITIONS_manifest_v0001.json',\n  validation_result_path: statusPath,\n  execution_evidence_path: executionEvidencePath,\n  publication_status: gate.should_publish ? 'published' : 'quarantined',\n  data_status: gate.should_publish ? dataStatus : candidateEnvelope.data_status,\n  uses_last_known_good: anyLkg,\n  schema_compatible_with_workflow_08: !!gate.should_publish,\n  source_ids_used: (gate.source_health || []).map(source => source.source_id),\n  route_sections: gate.route_sections || []\n};\nconst artifactPayloads = [];\nconst makeBinaryItem = async (filePath, payload, artifactType, mime = 'application/json') => {\n  const text = typeof payload === 'string' ? payload : JSON.stringify(payload, null, 2);\n  const buffer = Buffer.from(text, 'utf8');\n  const binary = await this.helpers.prepareBinaryData(buffer, filePath.split('/').pop(), mime);\n  return { json: { file_path: filePath, file_name: filePath.split('/').pop(), artifact_type: artifactType, content_hash: 'hash_' + hashString(text) }, binary: { data: binary } };\n};\nconst evidencePayload = {\n  schema_version: '1.0.0',\n  connector_id: gate.connector_id,\n  run_id: runId,\n  workflow_name: 'v0001.05_FloodConditionsConnector',\n  workflow_internal_id: 'pending_n8n_id',\n  execution_id: 'pending_n8n_execution_id',\n  connector_version: gate.connector_version || 'v0001',\n  started_at: candidateEnvelope.generated_at,\n  finished_at: now,\n  result: gate.should_publish ? 'success' : 'failed',\n  artifacts: [],\n  promotion_scope: gate.should_publish ? 'candidate_and_published' : 'none',\n  candidate_generated: true,\n  published_generated: !!gate.should_publish\n};\nconst files = [];\nif (gate.should_publish && publishedEnvelope) {\n  const publishedText = JSON.stringify(publishedEnvelope, null, 2);\n  const publishedHash = 'hash_' + hashString(publishedText);\n  evidencePayload.artifacts.push({ path: publishedPath, sha256: publishedHash });\n  evidencePayload.artifacts.push({ path: publishedCurrentPath, sha256: publishedHash });\n  evidencePayload.artifacts.push({ path: lkgCurrentPath, sha256: publishedHash });\n  evidencePayload.artifacts.push({ path: lkgArchivePath, sha256: publishedHash });\n  files.push(await makeBinaryItem(publishedPath, publishedEnvelope, 'published'));\n  files.push(await makeBinaryItem(publishedCurrentPath, { run_id: runId, artifact: publishedPath }, 'published_current'));\n  files.push(await makeBinaryItem(lkgCurrentPath, publishedEnvelope, 'last_known_good_current'));\n  files.push(await makeBinaryItem(lkgArchivePath, publishedEnvelope, 'last_known_good_archive'));\n  files.push(await makeBinaryItem(statusPath, statusDoc, 'status'));\n  files.push(await makeBinaryItem(statusArchivePath, statusDoc, 'status_archive'));\n} else {\n  const quarantineEnvelope = {\n    run_id: runId,\n    reason: gate.reason,\n    validation_errors: validationErrors,\n    validation_warnings: validationWarnings,\n    candidate_envelope: candidateEnvelope\n  };\n  evidencePayload.artifacts.push({ path: quarantinePath, sha256: 'hash_' + hashString(JSON.stringify(quarantineEnvelope, null, 2)) });\n  files.push(await makeBinaryItem(quarantinePath, quarantineEnvelope, 'quarantine'));\n  files.push(await makeBinaryItem(statusPath, statusDoc, 'status'));\n  files.push(await makeBinaryItem(statusArchivePath, statusDoc, 'status_archive'));\n}\nconst validationLogLines = [];\nfor (const source of sourceHealth) {\n  validationLogLines.push(JSON.stringify({\n    source_id: source.source_id,\n    check_name: 'source_health',\n    pass_fail: source.status === 'failed' ? 'fail' : 'pass',\n    message: source.status + ' / ' + source.record_count + ' record(s)',\n    timestamp: gate.generated_at || candidateEnvelope.generated_at\n  }));\n}\nvalidationLogLines.push(JSON.stringify({\n  source_id: 'CONNECTOR',\n  check_name: 'candidate_schema',\n  pass_fail: gate.should_publish ? 'pass' : 'fail',\n  message: gate.should_publish ? 'Candidate passed validation.' : (validationErrors.join('; ') || 'Validation failed.'),\n  timestamp: gate.generated_at || candidateEnvelope.generated_at\n}));\nvalidationLogLines.push(JSON.stringify({\n  source_id: 'CONNECTOR',\n  check_name: 'publish_gate',\n  pass_fail: gate.should_publish ? 'pass' : 'fail',\n  message: gate.should_publish ? 'Candidate promoted to published.' : gate.reason,\n  timestamp: now\n}));\nfiles.push(await makeBinaryItem(validationLogPath, validationLogLines.join('\\n'), 'validation_log', 'text/plain'));\nfiles.push(await makeBinaryItem(executionEvidencePath, evidencePayload, 'execution_evidence'));\nfiles.push(await makeBinaryItem(handoffPath, handoffDoc, 'handoff'));\nreturn files;\n"}},{"id":"write_final_artifacts","name":"Write Final Artifacts","type":"n8n-nodes-base.readWriteFile","typeVersion":1,"position":[3440,760],"parameters":{"operation":"write","fileName":"={{ $json.file_path }}","dataPropertyName":"data","options":{}}},{"id":"final_status_report","name":"Final Status Report","type":"n8n-nodes-base.code","typeVersion":2,"position":[3680,760],"parameters":{"mode":"runOnceForAllItems","jsCode":"\nconst gate = $('Publish Gate Decision').first().json;\nconst bundleItems = $('Build Final Artifact Bundle').all();\nconst candidate = $('Build Candidate Artifact').first().json.candidate_envelope;\nreturn [{ json: {\n  run_id: gate.run_id || candidate.run_id,\n  status: gate.should_publish ? 'PASSED' : 'FAILED',\n  candidate_written: true,\n  published_written: !!gate.should_publish,\n  quarantine_written: !gate.should_publish,\n  validation_log_written: true,\n  status_written: true,\n  handoff_written: true,\n  execution_evidence_written: true,\n  artifact_count_written: bundleItems.length,\n  published_path: gate.should_publish ? (gate.output_root || '/files/uw-issy-connectors') + '/published/05_FLOOD