| []).length > 0;\nconst publishedArtifactRef = gate.should_publish ? publishedPath : null;\nconst latestSuccessAt = (() => { const candidates = sourceHealth.map((source) => source.last_success_at).filter(Boolean).sort(); return candidates.length ? candidates[candidates.length - 1] : null; })();\nconst statusValue = gate.should_publish ? ((anyFailed || anyStale) ? 'degraded' : 'healthy') : 'failed';\nlet dataStatus = 'ok';\nif (allFailed) dataStatus = 'failed_fetch'; else if (allLkg) dataStatus = 'using_last_known_good'; else if (!hasEvents && !anyFailed && !anyStale) dataStatus = 'no_relevant_events'; else if (anyFailed || anyStale) dataStatus = 'degraded';\nconst publishedEnvelope = gate.should_publish ? { ...candidateEnvelope, published_at: now, data_status: dataStatus, connector_health: { ...candidateEnvelope.connector_health, status: statusValue, used_last_known_good: anyLkg }, validation_state: { ...candidateEnvelope.validation_state, candidate_validation_passed: true, published_from_candidate: true }, freshness: { ...candidateEnvelope.freshness, overall_state: allFailed ? 'unknown' : ((anyFailed || anyStale) ? 'stale' : 'fresh'), computed_at: now }, metadata: { ...candidateEnvelope.metadata, manual_review_required: false } } : null;\nconst statusDoc = { lane_id: '06_TRAIL_INFRASTRUCTURE_STATUS', run_id: gate.run_id || candidateEnvelope.run_id, last_fetch_at: gate.generated_at || candidateEnvelope.generated_at, last_success_at: gate.should_publish ? now : latestSuccessAt, status: statusValue, source_health: sourceHealth, error_messages: validationErrors.concat(gate.reason ? [gate.reason] : []).concat(gate.data_status === 'failed_fetch' ? ['failed_fetch'] : []), stale_data_fields: anyStale ? sourceHealth.filter((source) => source.status === 'stale' || source.status === 'using_last_known_good').map((source) => source.source_id) : [], used_last_known_good: anyLkg, published_artifact_ref: publishedArtifactRef, data_status: dataStatus };\nconst handoffDoc = { run_id: gate.run_id || candidateEnvelope.run_id, connector_id: gate.connector_id, lane: gate.lane || candidateEnvelope.lane, generated_at: gate.generated_at || candidateEnvelope.generated_at, published_at: gate.should_publish ? now : null, published_artifact: publishedArtifactRef, status: gate.should_publish ? statusValue : 'failed', data_status: dataStatus, ready_for_workflow_08: !!gate.should_publish, source_ids_used: (gate.source_health || []).map((source) => source.source_id), route_sections: gate.route_sections || [], connector_health: gate.should_publish ? publishedEnvelope.connector_health : candidateEnvelope.connector_health };\nconst validationLogLines = [];\nfor (const source of sourceHealth) { validationLogLines.push(JSON.stringify({ source_id: source.source_id, run_id: gate.run_id || candidateEnvelope.run_id, stage: 'source_normalize', check: 'source_health', result: source.status === 'failed' ? 'fail' : 'pass', message: source.status + ' / ' + source.record_count + ' record(s)', timestamp: gate.generated_at || candidateEnvelope.generated_at })); }\nvalidationLogLines.push(JSON.stringify({ source_id: 'CONNECTOR', run_id: gate.run_id || candidateEnvelope.run_id, stage: 'validation', check: 'candidate_schema', result: gate.should_publish ? 'pass' : 'fail', message: gate.should_publish ? 'Candidate passed validation.' : (validationErrors.join('; ') || 'Validation failed.'), timestamp: gate.generated_at || candidateEnvelope.generated_at }));\nvalidationLogLines.push(JSON.stringify({ source_id: 'CONNECTOR', run_id: gate.run_id || candidateEnvelope.run_id, stage: 'publish_gate', check: 'promotion', result: gate.should_publish ? 'pass' : 'fail', message: gate.should_publish ? 'Candidate promoted to published.' : gate.reason, timestamp: now }));\nconst validationLogText = validationLogLines.join('\\n');\nconst makeBinaryItem = async (filePath, payload, artifactType, mime = 'application/json') => { const body = typeof payload === 'string' ? payload : JSON.stringify(payload, null, 2); const buffer = Buffer.from(body, 'utf8'); const binary = await this.helpers.prepareBinaryData(buffer, filePath.split('/').pop(), mime); return { json: { file_path: filePath, file_name: filePath.split('/').pop(), artifact_type: artifactType }, binary: { data: binary } }; };\nconst items = [];\nif (gate.should_publish && publishedEnvelope) { items.push(await makeBinaryItem(publishedPath, publishedEnvelope, 'published')); items.push(await makeBinaryItem(publishedCurrentPath, publishedEnvelope, 'published_current')); items.push(await makeBinaryItem(lkgCurrentPath, publishedEnvelope, 'last_known_good_current')); } else { items.push(await makeBinaryItem(quarantinePath, { run_id: gate.run_id || candidateEnvelope.run_id, reason: gate.reason, validation_errors: validationErrors, validation_warnings: validationWarnings, candidate_envelope: candidateEnvelope }, 'quarantine')); }\nitems.push(await makeBinaryItem(validationLogPath, validationLogText, 'validation_log', 'text/plain'));\nitems.push(await makeBinaryItem(statusPath, statusDoc, 'status'));\nitems.push(await makeBinaryItem(handoffPath, handoffDoc, 'handoff'));\nreturn items;"}},{"id":"write_final_artifacts","name":"Write Final Artifacts","type":"n8n-nodes-base.readWriteFile","typeVersion":1,"position":[3420,1060],"parameters":{"operation":"write","fileName":"={{ $json.file_path }}","dataPropertyName":"data","options":{}}},{"id":"final_status_report","name":"Final Status Report","type":"n8n-nodes-base.code","typeVersion":2,"position":[3660,1060],"parameters":{"mode":"runOnceForAllItems","jsCode":"const gate = $('Publish Gate Decision').first().json;\nconst bundleItems = $('Build Final Artifact Bundle').all();\nconst candidate = $('Build Candidate Artifact').first().json.candidate_envelope;\nreturn [{ json: { run_id: gate.run_id || candidate.run_id, data_status: gate.data_status || candidate.data_status, status: gate.should_publish ? 'PASSED' : 'FAILED', candidate_written: true, published_written: !!gate